{
  "name": "HostCompare - Compare Hosting. Choose Better.",
  "short_name": "HostCompare",
  "description": "Compare web hosting, WordPress hosting, VPS, cloud and domains side by side.",
  "start_url": "/",
  "display": "standalone",
